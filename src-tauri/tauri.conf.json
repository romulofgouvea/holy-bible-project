{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bíblia Online",
  "version": "1.4.6",
  "identifier": "br.com.stevanini.holybible",
  "build": {
    "beforeBuildCommand": "npm run web:export",
    "beforeDevCommand": "npx expo start --web --port 8081",
    "devUrl": "http://localhost:8081",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bíblia Online",
        "width": 1100,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "languages": ["PortugueseBR"] }
    }
  }
}
